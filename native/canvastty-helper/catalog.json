      {
        "name": "update_task",
        "description": "Update the task you own. Only the root orchestrator can reassign tasks or change dependencies; complete work with complete_task.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
