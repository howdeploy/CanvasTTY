{
  "name": "canvastty",
  "version": "1.7.1",
  "private": true,
  "description": "A spatial desktop for local AI agents and real terminal sessions.",
  "desktopName": "CanvasTTY",
  "author": "howdeploy",
  "license": "MIT",
  "homepage": "https://github.com/howdeploy/CanvasTTY",
  "diagnostics": { "reportUrl": "https://canvastty.deploychan.webcam/canvastty/reports" },
  "repository": {
    "type": "git",
    "url": "https://github.com/howdeploy/CanvasTTY.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "control": "node scripts/canvastty-control.mjs",
    "dev": "electron-vite dev",
    "build": "npm run build:speech && npm run build:even && npm run build:mobile && npm run build:helpers -- --host && npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "prepackage:win": "node scripts/build-windows-agent-pipe-host.mjs --require-windows --self-test",
    "package:win": "npm run build && electron-builder --win nsis portable --publish never",
    "package:mac": "npm run build:mac-updater && npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "build:mac-updater": "node scripts/build-mac-updater.mjs",
    "smoke:browser": "node scripts/smoke-browser-electron.mjs",
    "smoke:browser:providers": "node scripts/smoke-browser-providers.mjs --deterministic",
    "smoke:browser:provider-helper": "node scripts/smoke-browser-providers.mjs --direct",
    "smoke:browser:providers:live": "node scripts/smoke-browser-providers.mjs --all",
    "smoke:cli-resolution:mac": "node scripts/smoke-packaged-cli-resolution.mjs",
    "smoke:appimage": "node scripts/smoke-appimage.mjs",
    "preview": "electron-vite preview",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "build:windows-pipe-host": "node scripts/build-windows-agent-pipe-host.mjs",
    "test:windows-pipe-host": "node scripts/build-windows-agent-pipe-host.mjs --require-windows --self-test",
    "test": "node --test --test-concurrency=1 --test-reporter=tap tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "install-electron && electron-rebuild -f -w node-pty && node scripts/build-windows-agent-pipe-host.mjs",
    "build:even": "npm run build --workspace integrations/even-g2",
    "build:mobile": "tsc --noEmit -p integrations/mobile/tsconfig.json && npm run build --prefix integrations/mobile",
    "test:even": "npm test --workspace integrations/even-g2",
    "pack:even:local": "npm run pack --workspace integrations/even-g2 -- --local-development",
    "predev": "npm run build:even && npm run build:mobile",
    "build:speech": "node scripts/build-companion-speech.mjs",
    "build:helpers": "node scripts/build-native-helpers.mjs",
    "pack:even": "npm run pack --workspace integrations/even-g2",
    "smoke:terminal-hidden": "node scripts/smoke-hidden-terminal-electron.mjs",
    "bench:terminal-hidden-renderer": "node scripts/smoke-hidden-terminal-electron.mjs --benchmark"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "electron-updater": "6.8.9",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lowlight": "3.3.0",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "secure-remote-password": "0.3.1",
    "unzipper": "^0.12.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "node-gyp": "12.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true
  },
  "workspaces": [
    "integrations/even-g2"
  ]
}
