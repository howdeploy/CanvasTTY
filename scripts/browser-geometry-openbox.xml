<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <!-- Keep Alt available to the application under test. This configuration is
       passed only to the disposable Xvfb window-manager process. -->
  <mouse>
    <context name="Frame">
      <mousebind button="W-Left" action="Drag"><action name="Move"/></mousebind>
    </context>
  </mouse>
</openbox_config>
